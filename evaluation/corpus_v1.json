      },
      "import_options": {},
      "reference_workflow": {
        "version": "1.0",
        "title": "Literal Contains",
        "steps": [
          {
            "operation": "read",
            "id": "input",
            "label": "Input",
            "files": [
              "repairs.csv"
            ]
          },
          {
            "operation": "filter",
            "id": "contains",
            "label": "Contains",
            "column": "Description",
            "comparison": "contains",
