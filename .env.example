# Server-side settings for live plan generation. Never commit your real .env.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
LLM_STRUCTURED=false

# Explicit response budget; includes reasoning tokens where the provider counts them.
LLM_MAX_COMPLETION_TOKENS=2048
