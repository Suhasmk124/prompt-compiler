    {
      "id": "dedup_last",
      "split": "validation",
      "instruction": "Remove duplicates by Contact ignoring case and surrounding whitespace. Keep the last occurrence, preserve original columns, sort Row ascending and export CSV.",
      "files": {
        "contacts.csv": "Row,Contact,Note\n1,a@demo.example,old\n2, A@DEMO.EXAMPLE ,new\n3,b@demo.example,other\n"
      },
      "import_options": {},
      "reference_workflow": {
        "version": "1.0",
        "title": "Dedup Last",
        "steps": [
          {
            "operation": "read",
            "id": "input",
            "label": "Input",
            "files": [
              "contacts.csv"
            ]
          },
          {
            "operation": "deduplicate",
            "id": "unique",
            "label": "Unique",
            "columns": [
              "Contact"
            ],
            "keep": "last",
            "case_sensitive": false,
            "source": "input"
          },
          {
            "operation": "sort",
            "id": "ordered",
            "label": "Ordered",
            "column": "Row",
            "descending": false,
            "source": "unique"
          },
          {
            "operation": "export",
            "id": "report",
            "label": "Report",
            "filename": "result.csv",
            "source": "ordered"
          }
        ]
      },
      "expected": {
        "kind": "table",
        "columns": [
          "Row",
          "Contact",
          "Note"
        ],
        "rows": [
          [
            2,
            " A@DEMO.EXAMPLE ",
            "new"
          ],
          [
            3,
            "b@demo.example",
            "other"
          ]
        ],
        "order_sensitive": true
      }
    },
    {
      "id": "calendar_days",
      "split": "validation",
      "instruction": "Calculate signed calendar days from Opened to Closed as Elapsed. Dates use YYYY-MM-DD. Preserve all original columns; export CSV.",
      "files": {
        "dates.csv": "ID,Opened,Closed\nD1,2024-02-28,2024-03-01\nD2,2024-03-01,2024-02-28\nD3,2024-03-01,\n"
      },
      "import_options": {},
      "reference_workflow": {
        "version": "1.0",
        "title": "Calendar Days",
        "steps": [
          {
            "operation": "read",
            "id": "input",
            "label": "Input",
            "files": [
              "dates.csv"
            ]
          },
          {
            "operation": "date_difference",
            "id": "days",
            "label": "Days",
            "start_column": "Opened",
            "end_column": "Closed",
            "start_format": "%Y-%m-%d",
            "end_format": "%Y-%m-%d",
            "output_column": "Elapsed",
            "source": "input"
          },
          {
            "operation": "export",
            "id": "report",
            "label": "Report",
            "filename": "result.csv",
            "source": "days"
          }
        ]
      },
      "expected": {
        "kind": "table",
        "columns": [
          "ID",
          "Opened",
          "Closed",
          "Elapsed"
        ],
        "rows": [
          [
            "D1",
            "2024-02-28",
            "2024-03-01",
            2
          ],
          [
            "D2",
            "2024-03-01",
            "2024-02-28",
            -2
          ],
          [
            "D3",
            "2024-03-01",
            null,
            null
          ]
        ]
      }
    },
